# =============================================================================
# Documentation Style Guidelines
# =============================================================================
# - Professional, direct tone (no marketing language)
# - Tables for all CLI options and configuration fields
# - Code blocks with language hints (yaml, bash, json)
# - Use admonitions sparingly (only for important notes/warnings)
# - Examples should be copy-pasteable
# - Keep pages focused and concise - one topic per page
# - No deep troubleshooting guides - keep it minimal but useful
# =============================================================================

[project]

site_name = "{{SITE_NAME}}"
site_description = "{{SITE_DESCRIPTION}}"
site_author = "{{SITE_AUTHOR}}"
site_url = "{{SITE_URL}}"

repo_name = "{{REPO_NAME}}"
repo_url = "{{REPO_URL}}"
edit_uri = "edit/main/docs/"

docs_dir = "docs"
site_dir = "site-build"

dev_addr = "127.0.0.1:{{DEV_PORT}}"

# Navigation is derived from the docs_dir directory structure when `nav` is
# absent. Define it explicitly only when you want a different order or
# grouping. TOML form:
#
# nav = [
#   { "Home" = "index.md" },
#   { "Guides" = [
#     { "Some Guide" = "guides/some-guide.md" },
#   ] },
# ]

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------
# The shared StrideLabs theme supplies the palette, the self-hosted type stack
# (no Google Fonts requests), the feature toggles, and the owl + project-icon
# header lockup. Anything set here overrides it.
#
# To opt this repo out of the shared look entirely, drop `name` and set
# `variant = "modern"` (or "classic" for the Material for MkDocs appearance).
[project.theme]
name = "stridelabs"

# The icon that says *which* tool this is -- rendered beside the shared owl.
# Any icon from the sets Zensical ships: material, lucide, fontawesome,
# octicons, simple.
[project.theme.icon]
logo = "{{LOGO_ICON}}"

# -----------------------------------------------------------------------------
# Extra
# -----------------------------------------------------------------------------
[[project.extra.social]]
icon = "fontawesome/brands/github"
link = "{{REPO_URL}}"

# -----------------------------------------------------------------------------
# Markdown extensions
# -----------------------------------------------------------------------------
[project.markdown_extensions.admonition]
[project.markdown_extensions.attr_list]
[project.markdown_extensions.md_in_html]

[project.markdown_extensions.toc]
permalink = true

[project.markdown_extensions.pymdownx.details]

# NOTE: the callable namespace is "zensical.extensions.emoji", not
# "material.extensions.emoji" - the latter aborts the build under Zensical
# with ModuleNotFoundError: No module named 'material'.
[project.markdown_extensions.pymdownx.emoji]
emoji_generator = "zensical.extensions.emoji.to_svg"
emoji_index = "zensical.extensions.emoji.twemoji"

[project.markdown_extensions.pymdownx.highlight]
anchor_linenums = true
line_spans = "__span"
pygments_lang_class = true

[project.markdown_extensions.pymdownx.inlinehilite]
[project.markdown_extensions.pymdownx.snippets]

# Mermaid works with no further configuration - Zensical initializes the JS
# runtime itself when it sees a mermaid fence.
[project.markdown_extensions.pymdownx.superfences]
custom_fences = [
  { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" },
]

[project.markdown_extensions.pymdownx.tabbed]
alternate_style = true

[project.markdown_extensions.pymdownx.tasklist]
custom_checkbox = true
