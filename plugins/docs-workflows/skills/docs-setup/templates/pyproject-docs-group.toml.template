# Merge this into the repo's existing pyproject.toml.
#
# If the repo has no pyproject.toml at all, create a minimal one first -- a
# dependency group cannot stand on its own:
#
#   [project]
#   name = "{{SITE_NAME}}-docs"
#   version = "0.1.0"
#   description = "Documentation for {{SITE_NAME}}"
#   requires-python = ">=3.12"
#
# Zensical is 0.0.x and ships frequently, so commit uv.lock and have CI use
# `uv sync --locked`. Do NOT also pin pymdown-extensions: it arrives
# transitively via zensical, and pinning it twice invites version conflicts.

[dependency-groups]
docs = [
    "zensical>=0.0.52",
    "stridelabs-docs-theme",
]

# The shared StrideLabs docs theme, installed straight from its public repo.
# No PyPI and no registry auth, so forks and outside contributors can still
# build the docs. uv.lock pins the resolved commit alongside the tag.
#
# Check the latest tag before adopting:
#   gh release view --repo charliek/stridelabs-docs-theme --json tagName -q .tagName
[tool.uv.sources]
stridelabs-docs-theme = { git = "https://github.com/charliek/stridelabs-docs-theme", tag = "v0.2.0" }
